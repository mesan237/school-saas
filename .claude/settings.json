{
    "permissions": {
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.backup)",
            "Read(./.env.testing)",
            "Read(./.env.staging)",
            "Read(./.env.production)",
            "Read(./.env.*.local)",
            "Edit(./.env)",
            "Edit(./.env.local)",
            "Edit(./.env.backup)",
            "Edit(./.env.testing)",
            "Edit(./.env.staging)",
            "Edit(./.env.production)",
            "Edit(./.env.*.local)",
            "Bash(cat *.env*)",
            "Bash(head *.env*)",
            "Bash(tail *.env*)",
            "Bash(less *.env*)",
            "Bash(more *.env*)",
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push * --force*)",
            "Bash(git push * -f*)",
            "Bash(git reset --hard*)",
            "Bash(php artisan db:wipe*)",
            "Bash(php artisan migrate:fresh --env=production*)",
            "PowerShell(Get-Content *.env*)",
            "PowerShell(gc *.env*)",
            "PowerShell(type *.env*)",
            "PowerShell(cat *.env*)",
            "PowerShell(git push --force*)",
            "PowerShell(git push -f*)",
            "PowerShell(git push * --force*)",
            "PowerShell(git push * -f*)",
            "PowerShell(git reset --hard*)",
            "PowerShell(php artisan db:wipe*)"
        ],
        "ask": [
            "Bash(git push*)",
            "Bash(git merge*)",
            "PowerShell(git push*)",
            "PowerShell(git merge*)",
            "Edit(./.github/workflows/**)",
            "Edit(./phpstan.neon)",
            "Edit(./phpunit.xml)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.php\"",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
